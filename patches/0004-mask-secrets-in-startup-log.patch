From: Nutcracker <bobodread876@users.noreply.github.com>
Subject: [PATCH] mask secrets in the startup log: nested backend options, and any setting named like a credential

Retires when: upstream masks nested payment backend options and secret settings by name (the fixed list misses mint_phoenixd_api_password and mint_lnd_rpc_macaroon).
Generated from the nutcracker/0.22.1 branch of Nutshell (see UPDATING.md), commits 3d0b2ff8..c473a627 (cashu/mint/startup.py)

---
 cashu/mint/startup.py | 42 ++++++++++++++++++++++++++++++------------
 1 file changed, 30 insertions(+), 12 deletions(-)

diff --git a/cashu/mint/startup.py b/cashu/mint/startup.py
index 22090889..9a91e930 100644
--- a/cashu/mint/startup.py
+++ b/cashu/mint/startup.py
@@ -4,6 +4,7 @@
 import asyncio
 import hashlib
 import importlib
+import re
 from copy import copy
 from typing import Any, Dict, Union
 
@@ -27,6 +28,33 @@ from ..payment import payment_method_registry
 if not __debug__:
     raise Exception("Nutshell cannot run in non-debug mode.")
 
+_SECRET_NAME = re.compile(
+    r"(password|passwd|secret|token|mnemonic|macaroon|rune|private_key|api_key|_key$)",
+    re.IGNORECASE,
+)
+
+
+def _is_secret_name(name: str) -> bool:
+    """Settings and backend options whose name says they hold a credential."""
+    return bool(_SECRET_NAME.search(name))
+
+
+def _redact_backend_options(options):
+    """Mask secrets in a payment backend config, including nested wallet configs."""
+    if isinstance(options, dict):
+        return {
+            option: (
+                "********"
+                if _is_secret_name(str(option))
+                else _redact_backend_options(setting)
+            )
+            for option, setting in options.items()
+        }
+    if isinstance(options, list):
+        return [_redact_backend_options(item) for item in options]
+    return options
+
+
 logger.debug("Enviroment Settings:")
 for key, value in settings.model_dump().items():
     if key in [
@@ -41,24 +69,14 @@ for key, value in settings.model_dump().items():
         "mint_lnd_rest_admin_macaroon",
         "mint_lnd_rest_invoice_macaroon",
         "mint_clnrest_rune",
-    ]:
