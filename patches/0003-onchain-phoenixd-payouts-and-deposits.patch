+from __future__ import annotations
+
+import asyncio
+import json
+import math
+import os
+import re
+import time
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, AsyncGenerator, Optional
+
+import bdkpython as bdk
+import httpx
+from loguru import logger
+
+from ..core.base import Amount, MeltQuote, Unit
+from ..lightning.base import PaymentStatus, PaymentStatusResult, StatusResponse
+from .chain import chain_source_from_config, parse_network, script_bytes
+
+if TYPE_CHECKING:
+    from .onchain import BdkOnchainBackend
+
+# Settings a deposit wallet inherits from the backend unless it sets its own.
+SHARED_WALLET_KEYS = (
+    "network",
+    "confirmations",
+    "electrum_url",
+    "socks5",
+    "validate_domain",
+)
+
+TXID_PATTERN = re.compile(r"^[0-9a-f]{64}$")
+
+
+class SendFailed(Exception):
+    """phoenixd answered and the splice-out was not created."""
+
+
+class PhoenixdOnchainBackend:
+    """Melt-only NUT-30 backend that pays out by splicing out of a phoenixd channel.
+
+    phoenixd exposes a single reusable swap-in address, so it cannot hand out the
+    per-quote deposit addresses NUT-30 minting needs. Payouts use ``sendtoaddress``,
+    which splices the amount out of the channel. phoenixd reports neither fee
+    estimates nor confirmation depth, so both come from a chain source: an Electrum
+    server such as the operator's own Fulcrum, or an Esplora API.
+    """
+
+    deposits: Optional[BdkOnchainBackend] = None
+
+    def __init__(self, unit: Unit, config: dict[str, Any]) -> None:
+        if unit != Unit.sat:
+            raise ValueError("the phoenixd onchain backend supports only sat")
+        self.unit = unit
+        self.network = parse_network(config.get("network", "bitcoin"))
+        self.confirmations = int(config.get("confirmations", 1))
+        self.min_amount = int(config.get("min_amount", 10_000))
+        max_amount = config.get("max_amount")
+        self.max_amount = int(max_amount) if max_amount is not None else None
+        # Our share of a splice-out: the shared channel input and output plus the
+        # destination output. Overestimating only raises the reserve; the user is
+        # charged the fee phoenixd reports, capped at the reserve.
+        self.splice_vbytes = int(config.get("splice_vbytes", 300))
+        self.fee_targets = [int(t) for t in config.get("fee_targets", [2, 6, 144])]
+        self.min_fee_rate = int(config.get("min_fee_rate", 1))
+
+        password = config.get("password")
+        password_file = config.get("password_file")
+        if password_file:
+            password = self._read_password(Path(str(password_file)))
+        if not password:
+            raise ValueError(
+                "phoenixd onchain backend requires password or password_file"
+            )
+        self._phoenixd = httpx.AsyncClient(
+            base_url=str(config.get("endpoint", "http://127.0.0.1:9740")),
+            auth=("", str(password)),
+            timeout=float(config.get("timeout", 60)),
+        )
+        self.chain = chain_source_from_config(config)
+        self._lock = asyncio.Lock()
+        # Quotes whose send phoenixd explicitly refused in this process. Only these
+        # may be reported FAILED when no splice-out is found for them.
+        self._refused: set[str] = set()
+
+        # Optional deposit wallet: a BDK wallet hands out per-quote deposit
+        # addresses, and its confirmed coins are swept into phoenixd's swap-in
+        # address so they end up in the channel that pays users out.
+        deposit_config = config.get("deposit_wallet")
+        if deposit_config:
+            from .onchain import BdkOnchainBackend
+
+            inherited = {k: config[k] for k in SHARED_WALLET_KEYS if k in config}
+            inherited.setdefault("network", "bitcoin")
+            self.deposits = BdkOnchainBackend(unit, {**inherited, **deposit_config})
+        self.sweep_threshold = int(config.get("sweep_threshold", 500_000))
+        self.sweep_max_age = int(config.get("sweep_max_age", 86_400))
+        self.sweep_min = int(config.get("sweep_min", 50_000))
+        self.sweep_fee_target = int(config.get("sweep_fee_target", 144))
+        self.poll_interval = float(config.get("poll_interval", 60))
+        status_file = config.get("status_file")
+        self.status_file = Path(str(status_file)) if status_file else None
+        self.last_sweep: Optional[dict[str, Any]] = None
+
+    @property
+    def supports_mint(self) -> bool:
+        return self.deposits is not None
+
+    @staticmethod
+    def _read_password(path: Path) -> str:
+        """Accept either a bare password or phoenix.conf (``http-password=...``)."""
+        text = path.read_text().strip()
+        for line in text.splitlines():
+            key, sep, value = line.partition("=")
+            if sep and key.strip() == "http-password":
+                return value.strip()
+        return text
+
+    def validate_address(self, address: str) -> None:
+        try:
+            bdk.Address(address, self.network)
+        except Exception as exc:
+            raise ValueError(f"invalid bitcoin address: {exc}") from exc
+
+    async def status(self) -> StatusResponse:
+        try:
+            r = await self._phoenixd.get("/getbalance")
+            r.raise_for_status()
+            return StatusResponse(balance=Amount(Unit.sat, int(r.json()["balanceSat"])))
+        except Exception as exc:
+            return StatusResponse(balance=Amount(Unit.sat, 0), error_message=str(exc))
+
+    async def new_address(self) -> str:
+        if self.deposits is None:
+            raise NotImplementedError(
+                "phoenixd cannot issue per-quote deposit addresses; configure deposit_wallet"
+            )
+        return await self.deposits.new_address()
+
+    async def received(self, address: str) -> int:
+        if self.deposits is None:
+            raise NotImplementedError("onchain minting needs a deposit_wallet")
+        return await self.deposits.received(address)
+
+    async def _swap_in_address(self) -> str:
+        r = await self._phoenixd.get("/getswapinaddress")
+        r.raise_for_status()
+        address = str(r.json()["address"])
+        self.validate_address(address)
+        return address
+
+    def _confirmed_utxos(self, wallet: Any, height: int) -> list[Any]:
+        """Unspent deposit outputs with at least ``confirmations`` confirmations."""
+        heights = {
+            tx.txid: tx.confirmation_time.height
+            for tx in wallet.list_transactions(False)
+            if tx.confirmation_time is not None
+        }
+        return [
+            utxo
+            for utxo in wallet.list_unspent()
+            if not utxo.is_spent
+            and utxo.outpoint.txid in heights
+            and height - heights[utxo.outpoint.txid] + 1 >= self.confirmations
+        ]
+
+    async def maybe_sweep(self, now: Optional[float] = None) -> Optional[str]:
+        """Sweep confirmed deposits into phoenixd when the threshold or age rule fires.
+
+        Sweeps when the confirmed deposit balance reaches ``sweep_threshold``, or
+        when it is at least ``sweep_min`` and its oldest coin has waited
+        ``sweep_max_age`` seconds. Waits while an earlier sweep is unconfirmed.
+        Returns the sweep txid, or None if nothing was swept.
+        """
+        deposits = self.deposits
+        if deposits is None:
+            return None
+        now = time.time() if now is None else now
+        async with deposits._lock:
+            wallet = deposits._wallet
+            await asyncio.to_thread(deposits._sync, True)
+            height = await asyncio.to_thread(deposits._blockchain.get_height)
+            transactions = await asyncio.to_thread(wallet.list_transactions, False)
+            if any(tx.sent > 0 and tx.confirmation_time is None for tx in transactions):
+                return None
+            utxos = await asyncio.to_thread(self._confirmed_utxos, wallet, height)
+            total = sum(int(u.txout.value) for u in utxos)
+            times = {
+                tx.txid: tx.confirmation_time.timestamp
+                for tx in transactions
+                if tx.confirmation_time is not None
+            }
+            oldest = min((times[u.outpoint.txid] for u in utxos), default=now)
+            due = total >= self.sweep_threshold or (
+                total >= self.sweep_min and now - oldest >= self.sweep_max_age
+            )
+            if not due:
+                return None
+
+            destination = await self._swap_in_address()
+            rate = await self.chain.fee_rate(self.sweep_fee_target)
+            fee_rate = float(max(self.min_fee_rate, math.ceil(rate or 0)))
+            script = bdk.Address(destination, self.network).script_pubkey()
+            builder = (
+                bdk.TxBuilder()
+                .add_utxos([u.outpoint for u in utxos])
+                .manually_selected_only()
+                .drain_to(script)
+                .fee_rate(fee_rate)
+                .enable_rbf()
+            )
+            result = await asyncio.to_thread(builder.finish, wallet)
+            if not await asyncio.to_thread(wallet.sign, result.psbt, None):
+                raise RuntimeError("could not sign deposit sweep")
+            transaction = result.psbt.extract_tx()
+            await asyncio.to_thread(deposits._blockchain.broadcast, transaction)
+            txid = transaction.txid()
+            # Sync right away so the swept coins stop counting as deposits.
+            await asyncio.to_thread(deposits._sync, True)
+        fee = result.transaction_details.fee or 0
+        self.last_sweep = {
+            "txid": txid,
+            "amount_sat": total - fee,
+            "fee_sat": fee,
+            "inputs": len(utxos),
+            "address": destination,
+            "time": int(now),
+        }
+        logger.info(
+            f"Swept {total} sat of deposits into phoenixd swap-in {destination}: {txid} (fee {fee} sat)"
+        )
+        return txid
+
+    async def deposit_balance(self) -> dict[str, int]:
+        if self.deposits is None:
+            return {}
+        async with self.deposits._lock:
+            balance = await asyncio.to_thread(self.deposits._wallet.get_balance)
+        return {
+            "confirmed_sat": int(balance.confirmed),
+            "pending_sat": int(balance.trusted_pending + balance.untrusted_pending),
+        }
+
+    async def write_status(self) -> None:
+        """Publish deposit-wallet and swap-in balances for an external reserves monitor."""
+        if self.status_file is None:
+            return
+        r = await self._phoenixd.get("/getbalance")
+        r.raise_for_status()
+        status = {
+            "updated": int(time.time()),
+            "deposit_wallet": await self.deposit_balance(),
+            "phoenixd_swap_in": r.json().get("swapIn"),
+            "last_sweep": self.last_sweep,
+        }
+        tmp = self.status_file.with_suffix(".tmp")
+        tmp.write_text(json.dumps(status, indent=2))
+        os.replace(tmp, self.status_file)
+
+    async def background_loop(self) -> AsyncGenerator[str, None]:
+        """Periodic deposit sync, sweep and status publication.
+
+        Shaped as the ledger's incoming-payment stream so it runs under the same
+        supervised, auto-restarting listener task. It never yields.
+        """
+        while True:
+            try:
+                await self.maybe_sweep()
+            except Exception as exc:
+                logger.error(f"deposit sweep failed: {exc}")
+            try:
+                await self.write_status()
+            except Exception as exc:
+                logger.warning(f"could not write onchain status file: {exc}")
+            await asyncio.sleep(self.poll_interval)
+            if False:  # pragma: no cover - makes this an async generator
+                yield ""
+
+    async def _fee_rates(self) -> dict[int, int]:
+        rates: dict[int, int] = {}
+        previous: Optional[float] = None
+        for target in sorted(self.fee_targets):
+            # A target the source cannot estimate inherits the next faster rate.
+            rate = await self.chain.fee_rate(target)
+            rate = rate if rate is not None else previous
+            if rate is None:
+                raise RuntimeError(f"no fee estimate for {target} blocks")
+            rates[target] = max(self.min_fee_rate, math.ceil(rate))
+            previous = rate
+        return rates
+
+    async def fee_quote(
+        self, address: str, amount: int
+    ) -> tuple[int, list[dict[str, int]]]:
+        self.validate_address(address)
+        if amount < self.min_amount:
+            raise ValueError(f"minimum onchain payout is {self.min_amount} sat")
+        if self.max_amount is not None and amount > self.max_amount:
+            raise ValueError(f"maximum onchain payout is {self.max_amount} sat")
+        rates = await self._fee_rates()
+        options = [
+            {
+                "fee_index": i,
+                "fee_reserve": rates[target] * self.splice_vbytes,
+                "estimated_blocks": target,
+            }
+            for i, target in enumerate(self.fee_targets)
+        ]
+        highest = max(option["fee_reserve"] for option in options)
+        r = await self._phoenixd.get("/getbalance")
+        r.raise_for_status()
+        if int(r.json()["balanceSat"]) < amount + highest:
+            raise ValueError("insufficient channel balance for this onchain payout")
+        return highest, options
+
+    def fee_rate_for_reserve(self, fee_reserve: int) -> int:
+        """The sat/vB rate a selected fee option was quoted at."""
+        return max(self.min_fee_rate, fee_reserve // self.splice_vbytes)
+
+    async def send(self, quote: MeltQuote, fee_reserve: int) -> str:
+        """Splice ``quote.amount`` out to ``quote.request`` and return the txid.
+
+        Raises SendFailed only when phoenixd answered without creating a splice.
+        Transport errors propagate so the ledger treats the payment as unknown.
+        """
+        self.validate_address(quote.request)
+        async with self._lock:
+            r = await self._phoenixd.post(
+                "/sendtoaddress",
+                data={
+                    "amountSat": str(quote.amount),
+                    "address": quote.request,
+                    "feerateSatByte": str(self.fee_rate_for_reserve(fee_reserve)),
+                },
+            )
+        if r.status_code in (400, 401, 403, 404):
+            self._refused.add(quote.quote)
+            raise SendFailed(f"phoenixd rejected sendtoaddress: HTTP {r.status_code}")
+        r.raise_for_status()
+        # phoenixd answers 200 with either the funding txid or a failure description.
+        body = r.text.strip()
+        if TXID_PATTERN.fullmatch(body):
+            return body
+        self._refused.add(quote.quote)
+        raise SendFailed(f"phoenixd did not splice out: {body[:200]}")
+
+    async def _splice_outs_since(self, since: Optional[int]) -> list[dict[str, Any]]:
+        """Splice-outs created in the day after ``since``, paging past Lightning sends."""
+        params: dict[str, Any] = {"all": "true", "limit": 500, "offset": 0}
+        if since:
+            params["from"] = since * 1000
+            params["to"] = (since + 86_400) * 1000
+        found: list[dict[str, Any]] = []
+        while True:
+            r = await self._phoenixd.get("/payments/outgoing", params=params)
+            r.raise_for_status()
+            page = r.json()
+            found += [
+                p for p in page if p.get("subType") == "splice_out" and p.get("txId")
+            ]
+            if len(page) < params["limit"]:
+                return found
+            params["offset"] += params["limit"]
+
+    def _destination_vout(
+        self, outputs: Optional[list[tuple[bytes, int]]], quote: MeltQuote
+    ) -> Optional[int]:
+        """Index of the output paying the quote's exact address and amount."""
+        target = script_bytes(quote.request, self.network)
+        for i, (script, value) in enumerate(outputs or []):
+            if script == target and value == quote.amount:
+                return i
+        return None
+
+    async def find_txid(self, quote: MeltQuote) -> Optional[str]:
+        """Recover the txid of a send whose response never reached the ledger.
+
+        A candidate counts only if the transaction pays the quote's exact address
+        and amount, so an unrelated splice-out can never settle this quote.
+        """
+        for payment in await self._splice_outs_since(quote.created_time):
+            recipient = int(payment["sent"]) - int(payment["fees"]) // 1000
+            if recipient != quote.amount:
+                continue
+            outputs = await self.chain.tx_outputs(payment["txId"])
+            if self._destination_vout(outputs, quote) is not None:
+                return payment["txId"]
+        return None
+
+    async def payment_status(self, quote: MeltQuote) -> PaymentStatus:
+        txid = quote.checking_id if TXID_PATTERN.fullmatch(quote.checking_id) else None
+        if txid is None:
+            txid = await self.find_txid(quote)
+        if txid is None:
+            if quote.quote in self._refused:
+                return PaymentStatus(result=PaymentStatusResult.FAILED)
+            # The send may still be in flight; never release proofs on a guess.
+            return PaymentStatus(result=PaymentStatusResult.NOT_FOUND)
+
+        outputs = await self.chain.tx_outputs(txid)
+        if outputs is None:
+            # Broadcast but not yet visible to the chain source.
+            return PaymentStatus(result=PaymentStatusResult.PENDING)
+        vout = self._destination_vout(outputs, quote)
+        if vout is None:
+            message = f"onchain tx {txid} does not pay quote {quote.quote}"
+            logger.error(message)
+            return PaymentStatus(
+                result=PaymentStatusResult.ERROR, error_message=message
+            )
+
+        fee = await self._our_fee(txid, quote.created_time)
+        height = await self.chain.confirmation_height(
+            txid, script_bytes(quote.request, self.network)
+        )
+        confirmed = False
+        if height is not None:
+            confirmed = await self.chain.tip_height() - height + 1 >= self.confirmations
+        return PaymentStatus(
+            result=(
+                PaymentStatusResult.SETTLED
+                if confirmed
+                else PaymentStatusResult.PENDING
+            ),
+            fee=Amount(Unit.sat, fee) if fee is not None else None,
+            preimage=f"{txid}:{vout}",
+        )
+
+    async def _our_fee(self, txid: str, since: Optional[int]) -> Optional[int]:
+        """Our share of the splice fee, as phoenixd recorded it."""
+        try:
+            for payment in await self._splice_outs_since(since):
+                if payment["txId"] == txid:
+                    return int(payment["fees"]) // 1000
+        except Exception as exc:
+            logger.warning(f"could not read phoenixd fee for {txid}: {exc}")
+        return None
