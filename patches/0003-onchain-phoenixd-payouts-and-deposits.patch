+"""Chain data for onchain backends: fee estimates, tip height, confirmations.
+
+Two sources are supported. Electrum talks to an Electrum server such as Fulcrum or
+electrs (optionally through a SOCKS5 proxy, e.g. Tor), so an operator can rely on
+their own node. Esplora talks to an Esplora HTTP API such as mempool.space.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import socket
+import ssl
+import struct
+from typing import Any, Optional, Protocol
+from urllib.parse import urlparse
+
+import bdkpython as bdk
+import httpx
+
+NETWORKS = {
+    "bitcoin": bdk.Network.BITCOIN,
+    "mainnet": bdk.Network.BITCOIN,
+    "testnet": bdk.Network.TESTNET,
+    "signet": bdk.Network.SIGNET,
+    "regtest": bdk.Network.REGTEST,
+}
+
+
+def parse_network(name: Any) -> bdk.Network:
+    key = str(name).lower()
+    if key not in NETWORKS:
+        raise ValueError(f"unknown network '{name}'")
+    return NETWORKS[key]
+
+
+def script_bytes(address: str, network: bdk.Network) -> bytes:
+    return bytes(bdk.Address(address, network).script_pubkey().to_bytes())
+
+
+class ChainSource(Protocol):
+    async def fee_rate(self, target_blocks: int) -> Optional[float]:
+        """Estimated sat/vB to confirm within ``target_blocks``, if known."""
+
+    async def tip_height(self) -> int: ...
+
+    async def tx_outputs(self, txid: str) -> Optional[list[tuple[bytes, int]]]:
+        """(scriptPubKey, value) per output, or None if the tx is unknown."""
+
+    async def confirmation_height(self, txid: str, script: bytes) -> Optional[int]:
+        """Block height of ``txid``, or None while unconfirmed."""
+
+
+class EsploraChain:
+    def __init__(self, url: str, timeout: float = 15) -> None:
+        self._client = httpx.AsyncClient(base_url=url.rstrip("/"), timeout=timeout)
+        self._estimates: Optional[dict[int, float]] = None
+
+    async def fee_rate(self, target_blocks: int) -> Optional[float]:
+        r = await self._client.get("/fee-estimates")
+        r.raise_for_status()
+        estimates = {int(k): float(v) for k, v in r.json().items()}
+        # Esplora omits some targets; use the nearest faster one available.
+        faster = [t for t in estimates if t <= target_blocks]
+        return estimates[max(faster)] if faster else None
+
+    async def tip_height(self) -> int:
+        r = await self._client.get("/blocks/tip/height")
+        r.raise_for_status()
+        return int(r.text)
+
+    async def _tx(self, txid: str) -> Optional[dict[str, Any]]:
+        r = await self._client.get(f"/tx/{txid}")
+        if r.status_code == 404:
+            return None
+        r.raise_for_status()
+        return r.json()
+
+    async def tx_outputs(self, txid: str) -> Optional[list[tuple[bytes, int]]]:
+        tx = await self._tx(txid)
+        if tx is None:
+            return None
+        return [
+            (bytes.fromhex(out["scriptpubkey"]), int(out["value"]))
+            for out in tx.get("vout", [])
+        ]
+
+    async def confirmation_height(self, txid: str, script: bytes) -> Optional[int]:
+        tx = await self._tx(txid)
+        status = (tx or {}).get("status", {})
+        return int(status["block_height"]) if status.get("confirmed") else None
+
+
+class ElectrumError(Exception):
+    pass
+
+
+class ElectrumChain:
+    """Minimal Electrum protocol client (JSON-RPC over TCP or TLS).
+
+    ``url`` is ``tcp://host:port`` or ``ssl://host:port``. ``socks5`` is an optional
+    ``host:port`` proxy; hostnames (including .onion) are resolved by the proxy.
+    Each call opens a short-lived connection, which keeps the client stateless and
+    tolerant of Tor circuit changes.
+    """
+
+    def __init__(
+        self,
+        url: str,
+        socks5: Optional[str] = None,
+        validate_domain: bool = True,
+        timeout: float = 30,
+    ) -> None:
+        parsed = urlparse(url)
+        if (
+            parsed.scheme not in ("tcp", "ssl")
+            or not parsed.hostname
+            or not parsed.port
+        ):
+            raise ValueError(
+                "electrum url must look like ssl://host:port or tcp://host:port"
+            )
+        self.host = parsed.hostname
+        self.port = parsed.port
+        self.use_ssl = parsed.scheme == "ssl"
+        self.socks5: Optional[tuple[str, int]] = None
+        if socks5:
+            host, _, port = socks5.rpartition(":")
+            self.socks5 = (host, int(port))
+        self.validate_domain = validate_domain
+        self.timeout = timeout
+
+    @staticmethod
+    def socks5_connect_request(host: str, port: int) -> bytes:
+        encoded = host.encode()
+        if len(encoded) > 255:
+            raise ValueError("hostname too long for SOCKS5")
+        return (
+            b"\x05\x01\x00\x03"
+            + bytes([len(encoded)])
+            + encoded
+            + struct.pack(">H", port)
+        )
+
+    @staticmethod
+    def _recv_exact(sock: socket.socket, n: int) -> bytes:
+        data = b""
+        while len(data) < n:
+            chunk = sock.recv(n - len(data))
+            if not chunk:
+                raise ElectrumError("connection closed during SOCKS5 handshake")
+            data += chunk
+        return data
+
+    def _socks5_handshake(self, sock: socket.socket) -> None:
+        sock.sendall(b"\x05\x01\x00")  # version 5, one method: no authentication
+        if self._recv_exact(sock, 2) != b"\x05\x00":
+            raise ElectrumError("SOCKS5 proxy refused no-auth method")
+        sock.sendall(self.socks5_connect_request(self.host, self.port))
+        version, reply, _, atyp = self._recv_exact(sock, 4)
+        if version != 5 or reply != 0:
+            raise ElectrumError(f"SOCKS5 connect failed with code {reply}")
+        # Skip the bound address the proxy reports.
+        if atyp == 1:
+            self._recv_exact(sock, 4 + 2)
+        elif atyp == 4:
+            self._recv_exact(sock, 16 + 2)
+        elif atyp == 3:
+            self._recv_exact(sock, self._recv_exact(sock, 1)[0] + 2)
+        else:
+            raise ElectrumError(f"SOCKS5 proxy returned unknown address type {atyp}")
+
+    def _open(self) -> socket.socket:
+        target = self.socks5 or (self.host, self.port)
+        sock = socket.create_connection(target, timeout=self.timeout)
+        try:
+            if self.socks5:
+                self._socks5_handshake(sock)
+            if self.use_ssl:
+                context = ssl.create_default_context()
+                if not self.validate_domain:
+                    context.check_hostname = False
+                    context.verify_mode = ssl.CERT_NONE
+                sock = context.wrap_socket(sock, server_hostname=self.host)
+            return sock
+        except Exception:
+            sock.close()
+            raise
+
+    def _call_sync(self, calls: list[tuple[str, list[Any]]]) -> list[Any]:
+        with self._open() as sock:
+            payload = b"".join(
+                json.dumps(
+                    {"jsonrpc": "2.0", "id": i, "method": m, "params": p}
+                ).encode()
+                + b"\n"
+                for i, (m, p) in enumerate(calls)
+            )
+            sock.sendall(payload)
+            results: dict[int, Any] = {}
+            buffer = b""
+            while len(results) < len(calls):
+                chunk = sock.recv(65536)
+                if not chunk:
+                    raise ElectrumError("electrum server closed the connection")
+                buffer += chunk
+                while b"\n" in buffer:
+                    line, buffer = buffer.split(b"\n", 1)
+                    if not line.strip():
+                        continue
+                    message = json.loads(line)
+                    if "id" not in message or message["id"] is None:
+                        continue  # subscription notification
+                    results[int(message["id"])] = message
+        out = []
+        for i in range(len(calls)):
+            message = results[i]
+            if message.get("error"):
+                raise ElectrumError(str(message["error"]))
+            out.append(message.get("result"))
+        return out
+
+    async def call(self, method: str, *params: Any) -> Any:
+        return (await asyncio.to_thread(self._call_sync, [(method, list(params))]))[0]
+
+    async def fee_rate(self, target_blocks: int) -> Optional[float]:
+        btc_per_kvb = await self.call("blockchain.estimatefee", target_blocks)
+        if btc_per_kvb is None or float(btc_per_kvb) <= 0:
+            return None
+        return float(btc_per_kvb) * 1e8 / 1000
+
+    async def tip_height(self) -> int:
+        header = await self.call("blockchain.headers.subscribe")
+        return int(header["height"])
+
+    async def tx_outputs(self, txid: str) -> Optional[list[tuple[bytes, int]]]:
+        try:
+            raw = await self.call("blockchain.transaction.get", txid, False)
+        except ElectrumError:
+            return None
+        tx = bdk.Transaction(list(bytes.fromhex(raw)))
+        return [(bytes(o.script_pubkey.to_bytes()), int(o.value)) for o in tx.output()]
+
+    @staticmethod
+    def scripthash(script: bytes) -> str:
+        return hashlib.sha256(script).digest()[::-1].hex()
+
+    async def confirmation_height(self, txid: str, script: bytes) -> Optional[int]:
+        history = await self.call(
+            "blockchain.scripthash.get_history", self.scripthash(script)
+        )
+        for entry in history or []:
+            if entry.get("tx_hash") == txid and int(entry.get("height", 0)) > 0:
+                return int(entry["height"])
+        return None
+
+
+def chain_source_from_config(config: dict[str, Any]) -> ChainSource:
+    """``electrum_url`` (with optional ``socks5`` and ``validate_domain``) wins over
+    ``esplora_url``; Esplora at mempool.space is the default."""
+    if config.get("electrum_url"):
+        return ElectrumChain(
+            str(config["electrum_url"]),
+            socks5=config.get("socks5"),
+            validate_domain=bool(config.get("validate_domain", True)),
+        )
+    return EsploraChain(str(config.get("esplora_url", "https://mempool.space/api")))
