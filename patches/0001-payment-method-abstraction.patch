+
+async def m043_add_payment_method_data_to_quotes(db: Database):
+    """Add opaque, server-internal storage for method-specific quote state."""
+    async with db.connect() as conn:
+        await conn.execute(
+            f"ALTER TABLE {db.table_with_schema('mint_quotes')} "
+            "ADD COLUMN method_data TEXT"
+        )
+        await conn.execute(
+            f"ALTER TABLE {db.table_with_schema('melt_quotes')} "
+            "ADD COLUMN method_data TEXT"
+        )
+
+
+async def m044_backfill_mint_quote_accounting(db: Database):
+    """Backfill cumulative accounting for quotes created before it was tracked.
+
+    m036 added these columns without populating them, so databases that ran it
+    still hold NULLs for older quotes.
+    """
+    async with db.connect() as conn:
+        await conn.execute(
+            f"""
+                UPDATE {db.table_with_schema('mint_quotes')}
+                SET amount_paid = CASE
+                        WHEN state IN ('PAID', 'ISSUED') THEN amount
+                        ELSE 0
+                    END,
+                    amount_issued = CASE
+                        WHEN state = 'ISSUED' THEN amount
+                        ELSE 0
+                    END,
+                    updated_at = COALESCE(updated_at, issued_time, paid_time, created_time)
+                WHERE amount_paid IS NULL OR amount_issued IS NULL
+            """
+        )
