+function getDbStats(summary = readSummary()) {
+  dbEntryCount.reset();
+  dbQuotesByState.reset();
+  if (!summary) return { available: false, reason: 'Waiting for current mint statistics.' };
+  const { tables, timestamp, requestsLast1h, requestsLast24h } = summary;
+  for (const [table, stats] of Object.entries(tables)) {
+    const label = { mintQuotes: 'mint_quotes', meltQuotes: 'melt_quotes' }[table] || table;
+    dbEntryCount.set({ table: label }, stats.total);
