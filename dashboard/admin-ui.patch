-  ({ DatabaseSync } = require('node:sqlite'));
-} catch {
-  DatabaseSync = null;
-}
-
-/** @returns {boolean} whether this Node.js build has node:sqlite. */
-function hasSqlite() {
-  return DatabaseSync !== null;
-}
-
-// The last SQLite error, logged once per distinct message so a persistent
-// failure shows up in the logs without repeating on every poll.
-let lastDbError = null;
-
-function noteDbError(message) {
-  if (message === lastDbError) return;
-  lastDbError = message;
-  if (message) {
-    console.error(`[admin-ui] SQLite: ${message}`);
-    addLog('error', 'db', `SQLite: ${message}`);
-  }
-}
