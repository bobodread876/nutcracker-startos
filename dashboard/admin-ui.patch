-        issued: totalIssued,
-        redeemed: totalSpent,
-        unit
-      };
-    }
-
-    return { available: true, balances };
-  } catch (error) {
-    addLog('error', 'admin', `getMintBalances error: ${error.message}`);
-    return { available: false, reason: error.message };
-  }
+function getMintBalances(summary = readSummary()) {
