-/** Run fn(db) on a read-only connection; returns null on any error. */
-function withDb(dbPath, fn) {
-  let db = null;
-  try {
-    db = new DatabaseSync(dbPath, { readOnly: true });
-    const result = fn(db);
-    noteDbError(null);
-    return result;
-  } catch (error) {
-    noteDbError(error.message);
-    return null;
-  } finally {
-    try { db && db.close(); } catch { /* ignored */ }
-  }
-}
