+    note.textContent = db.available
+      ? 'Figures updated ' + new Date(db.timestamp * 1000).toLocaleTimeString()
+      : 'Statistics delayed. Retrying automatically.';
+    this.updateMintBalances(balances);
+    this.updateDashboardDbStats(db);
+    this.renderDbPage(db);
