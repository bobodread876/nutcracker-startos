    * Update the compact DB stats panel on the dashboard overview cards.
    * Called with data from the /api/admin/dashboard response (which includes db).
    */
+  async refreshSummary() {
+    const token = this.token;
+    if (!token || this.summaryRequest) return;
+    this.summaryRequest = token;
+    const started = performance.now();
+    try {
+      const summary = await this.fetchWithAuth('/api/admin/summary');
+      const remaining = summary.validForMs - (performance.now() - started);
+      if (this.token !== token) return;
+      clearTimeout(this.summaryExpiry);
+      if (remaining <= 0 || !summary.db.available) return this.renderSummary({});
+      this.renderSummary(summary);
+      this.summaryExpiry = setTimeout(() => this.renderSummary({}), remaining);
+    } catch {
+      if (this.token === token) this.renderSummary({});
+    } finally {
+      if (this.summaryRequest === token) this.summaryRequest = null;
+    }
+  }
+
+  renderSummary({ db = { available: false }, balances } = {}) {
